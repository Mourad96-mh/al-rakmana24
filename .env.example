# --- Base de donnees (MongoDB Atlas) -----------------------------------------
# Cluster gratuit M0 suffisant pour demarrer. Choisir une region europeenne
# (Frankfurt / Paris) : le lectorat est marocain, la latence compte au build.
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/al_raqmana?retryWrites=true&w=majority

# --- Payload -----------------------------------------------------------------
# openssl rand -base64 32
PAYLOAD_SECRET=changeme-32-chars-minimum

# --- Site --------------------------------------------------------------------
# Sans slash final. Sert de base a sitemap / robots / JSON-LD / OG.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Medias (Cloudinary) -----------------------------------------------------
# Une seule variable suffit : Dashboard Cloudinary > API Environment variable.
# Contient le secret : jamais commitee, jamais dans une variable NEXT_PUBLIC_.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Variante si l'hebergeur n'aime pas les URL a secret :
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Dossier racine dans la mediatheque Cloudinary (defaut : al-raqmana24)
CLOUDINARY_FOLDER=al-raqmana24

# --- Newsletter (Lot 6) — optionnel : sans cle, le seam Brevo ne casse rien ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Analytics (Lot 7) — optionnel : sans domaine, Plausible n'est pas monte --
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
